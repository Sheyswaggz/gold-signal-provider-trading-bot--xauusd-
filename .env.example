# =============================================================================
# XAUUSD Signal Bot - Environment Configuration
# =============================================================================
# This file serves as a template for environment variables required by the
# XAUUSD trading signal bot. Copy this file to .env and update with your
# actual values. Never commit .env to version control.
#
# Usage: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Defines the runtime environment for the application
# Values: development, staging, production
# Impact: Controls logging verbosity, debug features, and error handling
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Sets the minimum log level for application output
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Impact: Controls log verbosity - use INFO for production, DEBUG for development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Connection URL for Redis cache and message broker
# Format: redis://[username:password@]host:port/database
# Impact: Used for caching market data, rate limiting, and pub/sub messaging
# Note: Ensure Redis service is running and accessible at this URL
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
# Host address for the FastAPI application server
# Values: 0.0.0.0 (all interfaces), 127.0.0.1 (localhost only)
# Impact: Controls network interface binding for the API server
API_HOST=0.0.0.0

# Port number for the FastAPI application server
# Values: 1024-65535 (use 8000 for development, 80/443 for production)
# Impact: Defines the port where the API endpoints are accessible
API_PORT=8000

# -----------------------------------------------------------------------------
# Financial Data Provider Configuration
# -----------------------------------------------------------------------------
# Specifies which financial data provider to use for market data
# Values: alpha_vantage, twelve_data, polygon, yahoo_finance
# Impact: Determines the source of XAUUSD price data and technical indicators
# Note: Each provider has different rate limits and data quality
FINANCIAL_DATA_PROVIDER=alpha_vantage

# API key for the selected financial data provider
# Format: Provider-specific API key string
# Impact: Required for authentication with the financial data provider
# Security: Keep this secret - never commit actual keys to version control
# Obtain from: https://www.alphavantage.co/support/#api-key (for Alpha Vantage)
FINANCIAL_DATA_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Maximum number of API requests allowed per minute to external data providers
# Values: 1-100 (depends on your API plan tier)
# Impact: Prevents exceeding provider rate limits and potential service suspension
# Note: Alpha Vantage free tier allows 5 requests/minute, 500 requests/day
RATE_LIMIT_PER_MINUTE=5

# -----------------------------------------------------------------------------
# Signal Generation Configuration
# -----------------------------------------------------------------------------
# Minimum confidence threshold (percentage) for generating trading signals
# Values: 0-100 (recommended: 60-80 for balanced approach)
# Impact: Higher values reduce false signals but may miss opportunities
# Note: Confidence is calculated from multiple technical indicators
SIGNAL_CONFIDENCE_THRESHOLD=70

# -----------------------------------------------------------------------------
# Notification System Configuration
# -----------------------------------------------------------------------------
# Enable or disable notification delivery for trading signals
# Values: true, false
# Impact: Controls whether signals are sent via configured notification channels
# Note: Set to false during testing to avoid spam notifications
ENABLE_NOTIFICATIONS=false

# -----------------------------------------------------------------------------
# Optional: Notification Channel Configuration (uncomment to enable)
# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notification Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_EMAIL=your_email@example.com
# SMTP_TO_EMAIL=recipient@example.com

# Webhook Configuration
# WEBHOOK_URL=https://your-webhook-endpoint.com/signals
# WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# Optional: Advanced Configuration (uncomment to customize)
# -----------------------------------------------------------------------------
# Database Configuration (if using persistent storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/xauusd_bot

# Monitoring and Observability
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# PROMETHEUS_PORT=9090

# Trading Parameters
# ANALYSIS_TIMEFRAME=1h
# LOOKBACK_PERIODS=100
# MAX_CONCURRENT_ANALYSES=5

# Security
# API_KEY_HEADER=X-API-Key
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# CORS_ENABLED=true

# Performance Tuning
# WORKER_PROCESSES=4
# WORKER_CONNECTIONS=1000
# KEEPALIVE_TIMEOUT=65